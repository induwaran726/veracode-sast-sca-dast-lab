<%- include('partials/header') %>
<h1>Orders</h1>
<p>Try IDOR (VULNERABLE): <a href="/orders/1">/orders/1</a> — SECURE: <a href="/orders-secure/1">/orders-secure/1</a></p>
<p>Create order (VULNERABLE, client total): <code>POST /orders {"productId":1,"quantity":1,"total":1}</code></p>
<p>Create order (SECURE): <code>POST /orders-secure {"productId":1,"quantity":1}</code></p>
<table>
  <tr><th>ID</th><th>Product</th><th>Qty</th><th>Total</th><th>Status</th></tr>
  <% orders.forEach(o => { %>
    <tr><td><%= o.id %></td><td><%= o.product_id %></td><td><%= o.quantity %></td><td><%= o.total_price %></td><td><%= o.status %></td></tr>
  <% }) %>
</table>
<%- include('partials/footer') %>
