# Copy to .env for local development. NEVER commit .env
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Microsoft Entra ID app registration (authorization code flow)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Session signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-me-local-only

# Demo administrator identity (used for /admin authorization)
ADMIN_EMAIL=dast-admin@example.com
